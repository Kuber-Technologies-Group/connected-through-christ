# .env.local
# ─────────────────────────────────────────────────────────────────────────────
# Connected Through Christ Platform — Environment Variables
# Copy this file, rename to .env.local, and fill in your values.
# NEVER commit .env.local to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key — SERVER-SIDE ONLY, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Resend (Email) ────────────────────────────────────────────────────────────
# Get this from: https://resend.com → API Keys

RESEND_API_KEY=re_your_resend_api_key_here

# The CTC team email that receives enquiry notifications
CTC_ADMIN_EMAIL=admin@connectedthroughchrist.com

# ── App ───────────────────────────────────────────────────────────────────────
# Use http://localhost:3000 for local dev; your live domain in production

NEXT_PUBLIC_SITE_URL=http://localhost:3000
